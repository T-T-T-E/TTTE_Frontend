@page "/"
@layout EmptyLayout

@using TTTE.Components.Layout
@using TTTE.Services
@using TTTE.DTOs

@inject NavigationManager navigationManager
@inject AutheService authService


@code {

    private UserSession userSession = new UserSession();
    private string errorMessage;
    private bool loading;

    private async Task LoginForm()
    {
        // 1. Iniciar la carga
        loading = true;
        errorMessage = string.Empty; // Limpiar mensaje de error anterior
        
        try
        {
            var token = await authService.Login(userSession);

            // Si el token es nulo o vacío, las credenciales son incorrectas.
            if (string.IsNullOrEmpty(token))
            {
                errorMessage = "Credenciales incorrectas";
                // No es necesario establecer 'loading = false' aquí si usamos 'finally'
                return;
            }

            // Si el token tiene un valor, el login fue exitoso.
            await authService.SetToken(token);
            // El 'loading = false' se ejecuta en el 'finally' después de la navegación, 
            // aunque en Blazor la navegación a otra página lo limpiará de todos modos.
            navigationManager.NavigateTo("/home");
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
        finally
        {
            // 2. Detener la carga siempre, independientemente del resultado (éxito, fallo de credenciales o excepción).
            loading = false;
        }
    }

}


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <link rel="stylesheet" href="css/login.css">

    <style>

        .login-card {
            background-color: white;
        }

        .login-form-section {
            background-color: white;
        }

        .login-image-section {
            background-color: #000000;
        }

        .buttonstyleLogin {
            background-color: #000000;
            color: white;
        }

            .buttonstyleLogin:hover {
                background-color: #c5ab7a;
                color: #000000;
            }

    </style>

</head>

<body>
    <div class="login-card">
        <div class="login-form-section">
            <h2 class="text-center mb-4e">Bienvenido</h2>
            <EditForm Model="userSession" OnValidSubmit="LoginForm">
                <div class="mb-3">
                    <label for="userInput" class="form-label">Email</label>
                    <InputText type="email" class="form-control" @bind-Value="userSession.email" placeholder="Ingresa su correo" requerid />
                </div>
                <div class="mb-3">
                    <label for="passwordInput" class="form-label">Contraseña</label>
                    <InputText type="password" class="form-control" @bind-Value="userSession.Password" placeholder="Ingresa su contraseña" required />
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="buttonstyleLogin" disabled="@loading">
                     @if (loading)
                     {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span class="ms-2">Ingresando...</span>
                     }
                     else
                     {
                         <span>Ingresar</span>
                     }
                     </button>
                  
                    <a href="/CreateCliente" class="buttonstyleCreate">Crear cuenta para clientes</a>
                </div>
            </EditForm>

            @if (!string.IsNullOrEmpty(errorMessage))
            {

                <div class="alert alert-danger" role="alert">@errorMessage</div>

            }

           

        </div>
        <div class="login-image-section">
            <img src="/img/logo1.jpeg">
        </div>
    </div>
</body>


