@page "/createcliente"
@layout EmptyLayout

@using TTTE.Components.Layout

@code {

}


<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <link rel="stylesheet" href="css/login.css">

</head>

<body>
    <div class="login-card">
        <div class="login-image-section">
            <img src="/img/Logo.png">
        </div>
        <div class="login-form-section">
            <h2 class="text-center my-4">Crear Nuevo Cliente</h2>
            <form>
                <div class="mb-3">
                    <label for="userInput" class="form-label">Nombre</label>
                    <input id="userInput" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="emailInput" class="form-label">Email</label>
                    <input id="emailInput" type="email" class="form-control"  />
                </div>
                <div class="mb-3">
                    <label for="passwordInput" class="form-label">Telefono</label>
                    <input id="passwordInput" type="number" class="form-control"  />
                </div>
                <div class="mb-3">
                    <label for="passwordInput" class="form-label">Contraseña</label>
                    <input id="passwordInput" type="password" class="form-control" />
                </div>
                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="buttonCreateCliente">Entrar</button>
                </div>
               
            </form>
           
        </div>
    </div>
</body>



