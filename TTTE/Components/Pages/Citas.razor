@page "/citas"
@using TTTE.DTOs
@using TTTE.Services
@inject CitaService CitaService
@inject AutheService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Gestión de Citas</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Gestión de Citas</h1>
                <div>
                    <button class="btn btn-outline-secondary me-2" @onclick="ToggleFiltroBarbero">
                        <i class="bi bi-funnel"></i> Filtrar por Barbero
                    </button>
                    <button class="btn btn-primary" @onclick="AbrirModalCrear">
                        <i class="bi bi-plus-circle"></i> Nueva Cita
                    </button>
                </div>
            </div>

            <!-- Filtro por Barbero -->
            @if (mostrarFiltroBarbero)
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="mb-0">Filtrar citas por Barbero</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <select class="form-select" @bind="idBarberoSeleccionado">
                                        <option value="0">Seleccione un barbero...</option>
                                        @foreach (var barbero in barberos)
                                        {
                                            <option value="@barbero.Id">@barbero.nombreCompleto</option>
                                        }
                                    </select>
                                    <button class="btn btn-primary" @onclick="AplicarFiltroBarbero"
                                            disabled="@(idBarberoSeleccionado == 0)">
                                        <i class="bi bi-search"></i> Buscar
                                    </button>
                                    <button class="btn btn-secondary" @onclick="LimpiarFiltro">
                                        <i class="bi bi-x-circle"></i> Limpiar
                                    </button>
                                </div>
                                @if (barberos.Count == 0)
                                {
                                    <div class="text-warning mt-2">
                                        <small>No se encontraron barberos registrados</small>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (mostrarMensaje)
            {
                <div class="alert @(tipoMensaje == "success" ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                    @mensaje
                    <button type="button" class="btn-close" @onclick="OcultarMensaje"></button>
                </div>
            }

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Lista de Citas</h5>
                    @if (filtroAplicado && barberoSeleccionado != null)
                    {
                        <span class="badge bg-info">
                            Filtrado por: @barberoSeleccionado.nombreCompleto
                        </span>
                    }
                </div>
                <div class="card-body">
                    @if (cargando)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2">Cargando citas...</p>
                        </div>
                    }
                    else if (citas != null && citas.Count == 0)
                    {
                        <div class="text-center text-muted">
                            <i class="bi bi-calendar-x" style="font-size: 3rem;"></i>
                            <p class="mt-2">
                                @if (filtroAplicado && barberoSeleccionado != null)
                                {
                                    <span>No hay citas registradas para el barbero: @barberoSeleccionado.nombreCompleto</span>
                                }
                                else
                                {
                                    <span>No hay citas registradas</span>
                                }
                            </p>
                        </div>
                    }
                    else if (citas != null)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Cliente</th>
                                        <th>Servicio</th>
                                        <th>Barbero</th>
                                        <th>Fecha</th>
                                        <th>Hora</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cita in citas)
                                    {
                                        <tr>
                                            <td>@cita.Id</td>
                                            <td>@cita.NombreCliente</td>
                                            <td>@cita.IdServicio</td>
                                            <td>
                                                @{
                                                    var barberoCita = barberos.FirstOrDefault(b => b.Id == cita.IdBarbero);
                                                }
                                                @if (barberoCita != null)
                                                {
                                                    @barberoCita.nombreCompleto
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Barbero @cita.IdBarbero</span>
                                                }
                                            </td>
                                            <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td>@cita.Hora.ToString(@"hh\:mm")</td>
                                            <td>
                                                <button class="btn btn-sm btn-warning me-1" @onclick="@(() => AbrirModalEditar(cita))">
                                                    <i class="bi bi-pencil"></i> Editar
                                                </button>
                                                <button class="btn btn-sm btn-danger" @onclick="@(() => EliminarCitaConfirmar(cita.Id))">
                                                    <i class="bi bi-trash"></i> Eliminar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <strong>Error:</strong> No se pudieron cargar las citas. Verifique la conexión.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Crear/Editar Cita -->
<div class="modal fade @(mostrarModal ? "show" : "")" style="display: @(mostrarModal ? "block" : "none")" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(esEdicion ? "Editar Cita" : "Nueva Cita")</h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>
            <EditForm Model="citaFormulario" OnValidSubmit="GuardarCita">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre del Cliente *</label>
                        <InputText class="form-control" @bind-Value="citaFormulario.NombreCliente" />
                        <ValidationMessage For="@(() => citaFormulario.NombreCliente)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ID Servicio *</label>
                        <InputNumber class="form-control" @bind-Value="citaFormulario.IdServicio" />
                        <ValidationMessage For="@(() => citaFormulario.IdServicio)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Barbero *</label>
                        <select class="form-select" @bind="citaFormulario.IdBarbero">
                            <option value="0">Seleccione un barbero...</option>
                            @foreach (var barbero in barberos)
                            {
                                <option value="@barbero.Id">@barbero.nombreCompleto</option>
                            }
                        </select>
                        <ValidationMessage For="@(() => citaFormulario.IdBarbero)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fecha *</label>
                        <InputDate class="form-control" @bind-Value="fechaSeleccionada" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hora *</label>
                        <InputText type="time" class="form-control" @bind-Value="citaFormulario.Hora" />
                        <ValidationMessage For="@(() => citaFormulario.Hora)" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @(esEdicion ? "Actualizar" : "Crear")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@if (mostrarModal)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<CitaDto>? citas;
    private List<DatosPersonal> barberos = new();
    private CrearCitaDto citaFormulario = new();
    private bool mostrarModal = false;
    private bool esEdicion = false;
    private int citaEditandoId = 0;
    private bool guardando = false;
    private bool cargando = true;
    private DateTime fechaSeleccionada = DateTime.Today;

    // Variables para el filtro de barbero
    private bool mostrarFiltroBarbero = false;
    private int idBarberoSeleccionado = 0;
    private DatosPersonal? barberoSeleccionado = null;
    private bool filtroAplicado = false;

    private bool mostrarMensaje = false;
    private string mensaje = "";
    private string tipoMensaje = "";

    protected override async Task OnInitializedAsync()
    {
        await VerificarAutenticacion();
        await CargarBarberos();
        await CargarTodasLasCitas();
    }

    private async Task VerificarAutenticacion()
    {
        var token = await AuthService.GetToken();
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task CargarBarberos()
    {
        try
        {
            barberos = await CitaService.ObtenerBarberosAsync();
            if (barberos.Count == 0)
            {
                Console.WriteLine("No se encontraron barberos");
                MostrarMensaje("No se encontraron barberos registrados", "warning");
            }
            else
            {
                Console.WriteLine($"Se cargaron {barberos.Count} barberos");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar barberos: {ex.Message}");
            MostrarMensaje("Error al cargar la lista de barberos", "error");
        }
    }

    private async Task CargarTodasLasCitas()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            citas = await CitaService.ObtenerCitasAsync();
            filtroAplicado = false;
            barberoSeleccionado = null;
        }
        catch (Exception ex)
        {
            MostrarMensaje("Error al cargar las citas: " + ex.Message, "error");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task AplicarFiltroBarbero()
    {
        if (idBarberoSeleccionado <= 0)
        {
            MostrarMensaje("Por favor seleccione un barbero", "error");
            return;
        }

        cargando = true;
        StateHasChanged();

        try
        {
            citas = await CitaService.ObtenerCitasPorBarberoAsync(idBarberoSeleccionado);
            barberoSeleccionado = barberos.FirstOrDefault(b => b.Id == idBarberoSeleccionado);
            filtroAplicado = true;

            if (citas.Count == 0)
            {
                MostrarMensaje($"No se encontraron citas para el barbero: {barberoSeleccionado?.nombreCompleto}", "info");
            }
            else
            {
                MostrarMensaje($"Se encontraron {citas.Count} citas para el barbero: {barberoSeleccionado?.nombreCompleto}", "success");
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al filtrar citas: {ex.Message}", "error");
            await CargarTodasLasCitas();
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task LimpiarFiltro()
    {
        idBarberoSeleccionado = 0;
        barberoSeleccionado = null;
        filtroAplicado = false;
        mostrarFiltroBarbero = false;
        await CargarTodasLasCitas();
        MostrarMensaje("Filtro limpiado - mostrando todas las citas", "info");
    }

    private void ToggleFiltroBarbero()
    {
        mostrarFiltroBarbero = !mostrarFiltroBarbero;
        if (!mostrarFiltroBarbero && filtroAplicado)
        {
            _ = LimpiarFiltro();
        }
    }

    private void AbrirModalCrear()
    {
        citaFormulario = new CrearCitaDto();
        fechaSeleccionada = DateTime.Today;
        esEdicion = false;
        mostrarModal = true;
    }

    private void AbrirModalEditar(CitaDto cita)
    {
        citaFormulario = new CrearCitaDto
            {
                NombreCliente = cita.NombreCliente,
                IdServicio = cita.IdServicio,
                IdBarbero = cita.IdBarbero,
                Fecha = cita.Fecha.ToString("yyyy-MM-dd"),
                Hora = cita.Hora.ToString(@"hh\:mm")
            };
        fechaSeleccionada = cita.Fecha;
        citaEditandoId = cita.Id;
        esEdicion = true;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        citaFormulario = new CrearCitaDto();
        esEdicion = false;
        citaEditandoId = 0;
    }

    private async Task GuardarCita()
    {
        guardando = true;
        citaFormulario.Fecha = fechaSeleccionada.ToString("yyyy-MM-dd");

        bool resultado;
        if (esEdicion)
        {
            resultado = await CitaService.ActualizarCitaAsync(citaEditandoId, citaFormulario);
        }
        else
        {
            resultado = await CitaService.CrearCitaAsync(citaFormulario);
        }

        if (resultado)
        {
            MostrarMensaje($"Cita {(esEdicion ? "actualizada" : "creada")} exitosamente", "success");
            CerrarModal();
            if (filtroAplicado)
            {
                await AplicarFiltroBarbero();
            }
            else
            {
                await CargarTodasLasCitas();
            }
        }
        else
        {
            MostrarMensaje($"Error al {(esEdicion ? "actualizar" : "crear")} la cita", "error");
        }

        guardando = false;
    }

    private async Task EliminarCitaConfirmar(int id)
    {
        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "¿Está seguro de que desea eliminar esta cita?");
        if (confirmado)
        {
            await EliminarCita(id);
        }
    }

    private async Task EliminarCita(int id)
    {
        var resultado = await CitaService.EliminarCitaAsync(id);
        if (resultado)
        {
            MostrarMensaje("Cita eliminada exitosamente", "success");
            if (filtroAplicado)
            {
                await AplicarFiltroBarbero();
            }
            else
            {
                await CargarTodasLasCitas();
            }
        }
        else
        {
            MostrarMensaje("Error al eliminar la cita", "error");
        }
    }

    private void MostrarMensaje(string msg, string tipo)
    {
        mensaje = msg;
        tipoMensaje = tipo;
        mostrarMensaje = true;
        StateHasChanged();

        Task.Delay(5000).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                mostrarMensaje = false;
                StateHasChanged();
            });
        });
    }

    private void OcultarMensaje()
    {
        mostrarMensaje = false;
        StateHasChanged();
    }
}