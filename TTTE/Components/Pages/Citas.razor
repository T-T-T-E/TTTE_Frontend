@page "/citas"
@using TTTE.DTOs
@using TTTE.Services
@using TTTE.Helpers
@inject CitaService CitaService
@inject AutheService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Gestión de Citas</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Gestión de Citas</h1>
                <div>
                    <!-- Botón para clientes -->
                    @if (EsCliente)
                    {
                        <button class="btn btn-info me-2" @onclick="ObtenerMisCitas"
                                disabled="@obteniendoMisCitas">
                            @if (obteniendoMisCitas)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-person-check"></i> Ver Mis Citas
                        </button>
                    }
                    <!-- Botón para administradores y barberos -->
                    @if (PuedeVerTodasLasCitas)
                    {
                        <button class="btn btn-outline-primary me-2" @onclick="VerTodasLasCitas">
                            <i class="bi bi-list-ul"></i> Ver Todas
                        </button>
                    }
                    <button class="btn btn-primary" @onclick="AbrirModalCrear">
                        <i class="bi bi-plus-circle"></i> Nueva Cita
                    </button>
                </div>
            </div>

            <!-- Filtro por Barbero - Disponible para todos los roles autenticados -->
            @if (estaAutenticado && barberos.Any())
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <label class="form-label"><strong>Filtrar citas por barbero:</strong></label>
                                <div class="input-group">
                                    <select class="form-select" @bind="idBarberoSeleccionado">
                                        <option value="0">Seleccione un barbero...</option>
                                        @foreach (var barbero in barberos)
                                        {
                                            <option value="@barbero.Id">@barbero.nombreCompleto</option>
                                        }
                                    </select>
                                    <button class="btn btn-primary" @onclick="AplicarFiltroBarbero"
                                            disabled="@(idBarberoSeleccionado == 0 || aplicandoFiltro)">
                                        @if (aplicandoFiltro)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="bi bi-search"></i> Buscar Citas
                                    </button>
                                    <button class="btn btn-outline-secondary" @onclick="LimpiarFiltro"
                                            disabled="@(!filtroAplicado && !filtroClienteAplicado)">
                                        <i class="bi bi-x-circle"></i> Limpiar
                                    </button>
                                </div>
                                <small class="form-text text-muted">
                                    @if (EsCliente)
                                    {
                                        <span>Seleccione un barbero para ver las citas que tienes con él</span>
                                    }
                                    else
                                    {
                                        <span>Seleccione un barbero para ver todas sus citas</span>
                                    }
                                </small>
                            </div>
                            <div class="col-md-4">
                                @if (filtroAplicado && barberoSeleccionado != null)
                                {
                                    <div class="alert alert-info mb-0 py-2">
                                        <i class="bi bi-info-circle"></i>
                                        @if (EsCliente)
                                        {
                                            <span>Mis citas con: <strong>@barberoSeleccionado.nombreCompleto</strong></span>
                                        }
                                        else
                                        {
                                            <span>Filtrado por: <strong>@barberoSeleccionado.nombreCompleto</strong></span>
                                        }
                                    </div>
                                }
                                else if (filtroClienteAplicado)
                                {
                                    <div class="alert alert-success mb-0 py-2">
                                        <i class="bi bi-person-check"></i>
                                        <span>Mostrando <strong>todas mis citas</strong></span>
                                    </div>
                                }
                                else if (!filtroAplicado && !filtroClienteAplicado && PuedeVerTodasLasCitas)
                                {
                                    <div class="alert alert-secondary mb-0 py-2">
                                        <i class="bi bi-eye"></i>
                                        <span>Viendo <strong>todas las citas</strong></span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Mensajes informativos -->
            @if (!estaAutenticado)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    Debe iniciar sesión para ver las citas.
                </div>
            }
            else if (EsCliente && !filtroAplicado && !filtroClienteAplicado)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Selecciona un barbero para ver tus citas específicas o usa "Ver Mis Citas" para ver todas tus citas.
                </div>
            }

            @if (mostrarMensaje)
            {
                <div class="alert alert-@(tipoMensaje) alert-dismissible fade show" role="alert">
                    <i class="bi bi-@(tipoMensaje == "success" ? "check-circle" : tipoMensaje == "warning" ? "exclamation-triangle" : "exclamation-circle")"></i>
                    @mensaje
                    <button type="button" class="btn-close" @onclick="OcultarMensaje"></button>
                </div>
            }

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        @if (filtroAplicado && barberoSeleccionado != null)
                        {
                            @if (EsCliente)
                            {
                                <span>Mis Citas con @barberoSeleccionado.nombreCompleto</span>
                            }
                            else
                            {
                                <span>Citas de @barberoSeleccionado.nombreCompleto</span>
                            }
                        }
                        else if (filtroClienteAplicado)
                        {
                            <span>Mis Citas</span>
                        }
                        else
                        {
                            <span>Lista de Citas</span>
                        }
                    </h5>
                    @if (citas != null)
                    {
                        <div>
                            <span class="badge bg-primary">Total: @citas.Count</span>
                            @if (filtroClienteAplicado)
                            {
                                <span class="badge bg-success ms-2">Mis Citas</span>
                            }
                            @if (filtroAplicado)
                            {
                                <span class="badge bg-info ms-2">Filtrado</span>
                            }
                        </div>
                    }
                </div>
                <div class="card-body">
                    @if (cargando)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 text-muted">Cargando citas...</p>
                        </div>
                    }
                    else if (citas == null)
                    {
                        <div class="alert alert-danger">
                            <strong>Error:</strong> No se pudieron cargar las citas. Verifique la conexión.
                        </div>
                    }
                    else if (citas.Count == 0)
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-calendar-x" style="font-size: 3rem;"></i>
                            <p class="mt-2">
                                @if (filtroAplicado && barberoSeleccionado != null)
                                {
                                    @if (EsCliente)
                                    {
                                        <span>No tienes citas con @barberoSeleccionado.nombreCompleto</span>
                                    }
                                    else
                                    {
                                        <span>No hay citas para @barberoSeleccionado.nombreCompleto</span>
                                    }
                                }
                                else if (filtroClienteAplicado)
                                {
                                    <span>No tienes citas registradas</span>
                                }
                                else
                                {
                                    <span>No hay citas registradas</span>
                                }
                            </p>
                            @if (filtroAplicado || filtroClienteAplicado)
                            {
                                <button class="btn btn-outline-primary mt-2" @onclick="LimpiarFiltro">
                                    <i class="bi bi-arrow-counterclockwise"></i> Ver todas las citas
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Cliente</th>
                                        <th>Servicio</th>
                                        <th>Barbero</th>
                                        <th>Fecha</th>
                                        <th>Hora</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cita in GetCitasPagadas())
                                    {
                                        <tr>
                                            <td>@cita.Id</td>
                                            <td>
                                                @cita.NombreCliente
                                                @if (filtroClienteAplicado && cita.IdCliente == idUsuarioActual)
                                                {
                                                    <span class="badge bg-success ms-1" title="Mi cita">
                                                        <i class="bi bi-person-fill"></i>
                                                    </span>
                                                }
                                            </td>
                                            <td>@cita.IdServicio</td>
                                            <td>@ObtenerNombreBarbero(cita.IdBarbero)</td>
                                            <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td><span class="badge bg-secondary">@cita.Hora.ToString(@"hh\:mm")</span></td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-warning" @onclick="@(() => AbrirModalEditar(cita))">
                                                        <i class="bi bi-pencil"></i> Editar
                                                    </button>
                                                    <button class="btn btn-danger" @onclick="@(() => EliminarCitaConfirmar(cita.Id))">
                                                        <i class="bi bi-trash"></i> Eliminar
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            @if (totalPages > 1)
                            {
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div>
                                        Mostrando @(((currentPage - 1) * pageSize) + 1) a
                                        @(Math.Min(currentPage * pageSize, citas.Count)) de @citas.Count registros
                                    </div>
                                    <nav>
                                        <ul class="pagination mb-0">
                                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                                <button class="page-link" @onclick="() => CambiarPagina(currentPage - 1)">
                                                    Anterior
                                                </button>
                                            </li>

                                            @for (int i = 1; i <= totalPages; i++)
                                            {
                                                <li class="page-item @(i == currentPage ? "active" : "")">
                                                    <button class="page-link" @onclick="() => CambiarPagina(i)">
                                                        @i
                                                    </button>
                                                </li>
                                            }

                                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                                <button class="page-link" @onclick="() => CambiarPagina(currentPage + 1)">
                                                    Siguiente
                                                </button>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Crear/Editar Cita -->
<div class="modal fade @(mostrarModal ? "show" : "")" style="display: @(mostrarModal ? "block" : "none")" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(esEdicion ? "Editar Cita" : "Nueva Cita")</h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>
            <EditForm Model="citaFormulario" OnValidSubmit="GuardarCita">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre del Cliente *</label>
                        <InputText class="form-control" @bind-Value="citaFormulario.NombreCliente" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ID Servicio *</label>
                        <InputNumber class="form-control" @bind-Value="citaFormulario.IdServicio" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Barbero *</label>
                        <select class="form-select" @bind="citaFormulario.IdBarbero">
                            <option value="0">Seleccione un barbero...</option>
                            @foreach (var barbero in barberos)
                            {
                                <option value="@barbero.Id">@barbero.nombreCompleto</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fecha *</label>
                        <InputDate class="form-control" @bind-Value="fechaSeleccionada" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hora *</label>
                        <InputText type="time" class="form-control" @bind-Value="citaFormulario.Hora" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @(esEdicion ? "Actualizar" : "Crear")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@if (mostrarModal)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<CitaDto>? citas;
    private List<DatosPersonal> barberos = new();
    private CrearCitaDto citaFormulario = new();
    private bool mostrarModal = false;
    private bool esEdicion = false;
    private int citaEditandoId = 0;
    private bool guardando = false;
    private bool cargando = true;
    private bool obteniendoMisCitas = false;
    private bool aplicandoFiltro = false;
    private DateTime fechaSeleccionada = DateTime.Today;
    private bool estaAutenticado = false;
    private int? rolUsuario = null;
    private int idUsuarioActual = 0;

    // Variables para paginación
    private int currentPage = 1;
    private const int pageSize = 5;
    private int totalPages => citas != null ? (int)Math.Ceiling(citas.Count / (double)pageSize) : 1;

    // Variables para el filtro
    private int idBarberoSeleccionado = 0;
    private DatosPersonal? barberoSeleccionado = null;
    private bool filtroAplicado = false;
    private bool filtroClienteAplicado = false;

    // Mensajes
    private bool mostrarMensaje = false;
    private string mensaje = "";
    private string tipoMensaje = "info";

    // Propiedades computadas para permisos
    private bool EsCliente => rolUsuario.HasValue && rolUsuario.Value == 1;
    private bool EsBarbero => rolUsuario.HasValue && rolUsuario.Value == 2;
    private bool EsAdmin => rolUsuario.HasValue && rolUsuario.Value == 3;
    private bool PuedeVerTodasLasCitas => EsBarbero || EsAdmin;

    protected override async Task OnInitializedAsync()
    {
        await VerificarAutenticacion();
        await CargarDatosIniciales();
    }

    private async Task VerificarAutenticacion()
    {
        estaAutenticado = await AuthService.IsAuthenticated();
        if (estaAutenticado)
        {
            await ObtenerRolUsuario();
            await ObtenerIdUsuarioActual();
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task ObtenerRolUsuario()
    {
        try
        {
            var token = await AuthService.GetToken();
            rolUsuario = JwtHelper.GetUserRoleFromToken(token);
            Console.WriteLine($"Rol obtenido: {rolUsuario}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al obtener rol: {ex.Message}");
        }
    }

    private async Task ObtenerIdUsuarioActual()
    {
        try
        {
            var token = await AuthService.GetToken();
            idUsuarioActual = JwtHelper.GetUserIdFromToken(token);
            Console.WriteLine($"ID usuario obtenido: {idUsuarioActual}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al obtener ID usuario: {ex.Message}");
        }
    }

    private async Task CargarDatosIniciales()
    {
        await CargarBarberos();

        // Según el rol, cargar diferentes datos iniciales
        if (EsCliente)
        {
            // Para clientes, no cargar todas las citas inicialmente
            citas = new List<CitaDto>();
            cargando = false;
            StateHasChanged();
        }
        else if (PuedeVerTodasLasCitas)
        {
            // Para barberos y admin, cargar todas las citas
            await CargarTodasLasCitas();
        }
    }

    private async Task CargarBarberos()
    {
        try
        {
            barberos = await CitaService.ObtenerBarberosAsync();
            Console.WriteLine($"Barberos cargados: {barberos.Count}");

            if (barberos.Count == 0)
            {
                MostrarMensaje("No se encontraron barberos registrados", "warning");
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje("Error al cargar barberos: " + ex.Message, "danger");
        }
    }

    private async Task CargarTodasLasCitas()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            citas = await CitaService.ObtenerCitasAsync();
            LimpiarFiltroEstado();
            currentPage = 1;

            if (citas.Count > 0)
            {
                MostrarMensaje($"Se cargaron {citas.Count} citas", "success");
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje("Error al cargar citas: " + ex.Message, "danger");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    // Método para que clientes vean todas sus citas
    private async Task ObtenerMisCitas()
    {
        if (idUsuarioActual == 0)
        {
            MostrarMensaje("No se pudo identificar al cliente", "danger");
            return;
        }

        obteniendoMisCitas = true;
        cargando = true;
        StateHasChanged();

        try
        {
            citas = await CitaService.ObtenerCitasPorClienteAsync(idUsuarioActual);
            filtroClienteAplicado = true;
            filtroAplicado = false;
            barberoSeleccionado = null;
            idBarberoSeleccionado = 0;
            currentPage = 1;

            MostrarMensaje(citas.Count > 0
                ? $"Se encontraron {citas.Count} de tus citas"
                : "No tienes citas registradas",
                citas.Count > 0 ? "success" : "info");
        }
        catch (Exception ex)
        {
            MostrarMensaje("Error al obtener tus citas: " + ex.Message, "danger");
        }
        finally
        {
            obteniendoMisCitas = false;
            cargando = false;
            StateHasChanged();
        }
    }

    // Método para filtrar por barbero (funciona para todos los roles)
    private async Task AplicarFiltroBarbero()
    {
        if (idBarberoSeleccionado == 0) return;

        aplicandoFiltro = true;
        cargando = true;
        StateHasChanged();

        try
        {
            barberoSeleccionado = barberos.FirstOrDefault(b => b.Id == idBarberoSeleccionado);

            if (EsCliente)
            {
                // Para clientes: obtener todas sus citas y filtrar localmente por barbero
                var todasMisCitas = await CitaService.ObtenerCitasPorClienteAsync(idUsuarioActual);
                citas = todasMisCitas.Where(c => c.IdBarbero == idBarberoSeleccionado).ToList();
            }
            else
            {
                // Para barberos y admin: usar el endpoint del API
                citas = await CitaService.ObtenerCitasPorBarberoAsync(idBarberoSeleccionado);
            }

            filtroAplicado = true;
            filtroClienteAplicado = false;
            currentPage = 1;

            MostrarMensaje(citas.Count > 0
                ? $"Se encontraron {citas.Count} citas"
                : "No hay citas para el barbero seleccionado",
                citas.Count > 0 ? "success" : "info");
        }
        catch (Exception ex)
        {
            MostrarMensaje("Error al aplicar filtro: " + ex.Message, "danger");
        }
        finally
        {
            aplicandoFiltro = false;
            cargando = false;
            StateHasChanged();
        }
    }

    // Método para ver todas las citas (solo barberos y admin)
    private async Task VerTodasLasCitas()
    {
        await CargarTodasLasCitas();
    }

    private async Task LimpiarFiltro()
    {
        idBarberoSeleccionado = 0;
        filtroAplicado = false;
        filtroClienteAplicado = false;
        barberoSeleccionado = null;

        if (PuedeVerTodasLasCitas)
        {
            await CargarTodasLasCitas();
        }
        else
        {
            citas = new List<CitaDto>();
            cargando = false;
            StateHasChanged();
        }

        MostrarMensaje("Filtro limpiado", "info");
    }

    private void LimpiarFiltroEstado()
    {
        filtroAplicado = false;
        filtroClienteAplicado = false;
        barberoSeleccionado = null;
    }

    // Métodos de paginación
    private IEnumerable<CitaDto> GetCitasPagadas()
    {
        if (citas == null) return Enumerable.Empty<CitaDto>();

        return citas
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);
    }

    private void CambiarPagina(int pagina)
    {
        if (pagina >= 1 && pagina <= totalPages)
        {
            currentPage = pagina;
            StateHasChanged();
        }
    }

    // Helper methods
    private string ObtenerNombreBarbero(int idBarbero)
    {
        return barberos.FirstOrDefault(b => b.Id == idBarbero)?.nombreCompleto ?? $"Barbero {idBarbero}";
    }

    // CRUD Operations
    private void AbrirModalCrear()
    {
        citaFormulario = new CrearCitaDto();
        fechaSeleccionada = DateTime.Today;
        esEdicion = false;
        mostrarModal = true;
        StateHasChanged();
    }

    private void AbrirModalEditar(CitaDto cita)
    {
        citaFormulario = new CrearCitaDto
            {
                NombreCliente = cita.NombreCliente,
                IdServicio = cita.IdServicio,
                IdBarbero = cita.IdBarbero,
                Fecha = cita.Fecha.ToString("yyyy-MM-dd"),
                Hora = cita.Hora.ToString(@"hh\:mm")
            };
        fechaSeleccionada = cita.Fecha;
        citaEditandoId = cita.Id;
        esEdicion = true;
        mostrarModal = true;
        StateHasChanged();
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        citaFormulario = new CrearCitaDto();
        StateHasChanged();
    }

    private async Task GuardarCita()
    {
        guardando = true;
        StateHasChanged();

        citaFormulario.Fecha = fechaSeleccionada.ToString("yyyy-MM-dd");

        bool resultado = esEdicion
            ? await CitaService.ActualizarCitaAsync(citaEditandoId, citaFormulario)
            : await CitaService.CrearCitaAsync(citaFormulario);

        if (resultado)
        {
            MostrarMensaje($"Cita {(esEdicion ? "actualizada" : "creada")} exitosamente", "success");
            CerrarModal();

            // Recargar según el filtro actual
            if (filtroClienteAplicado)
            {
                await ObtenerMisCitas();
            }
            else if (filtroAplicado)
            {
                await AplicarFiltroBarbero();
            }
            else if (PuedeVerTodasLasCitas)
            {
                await CargarTodasLasCitas();
            }
        }
        else
        {
            MostrarMensaje($"Error al {(esEdicion ? "actualizar" : "crear")} la cita", "danger");
        }

        guardando = false;
        StateHasChanged();
    }

    private async Task EliminarCitaConfirmar(int id)
    {
        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "¿Está seguro de eliminar esta cita?");
        if (confirmado)
        {
            await EliminarCita(id);
        }
    }

    private async Task EliminarCita(int id)
    {
        if (await CitaService.EliminarCitaAsync(id))
        {
            MostrarMensaje("Cita eliminada exitosamente", "success");

            // Recargar según el filtro actual
            if (filtroClienteAplicado)
            {
                await ObtenerMisCitas();
            }
            else if (filtroAplicado)
            {
                await AplicarFiltroBarbero();
            }
            else if (PuedeVerTodasLasCitas)
            {
                await CargarTodasLasCitas();
            }
        }
        else
        {
            MostrarMensaje("Error al eliminar la cita", "danger");
        }
    }

    // Mensajes
    private void MostrarMensaje(string msg, string tipo)
    {
        mensaje = msg;
        tipoMensaje = tipo;
        mostrarMensaje = true;
        StateHasChanged();
        _ = OcultarMensajeAutomatico();
    }

    private async Task OcultarMensajeAutomatico()
    {
        await Task.Delay(5000);
        mostrarMensaje = false;
        StateHasChanged();
    }

    private void OcultarMensaje()
    {
        mostrarMensaje = false;
        StateHasChanged();
    }
}