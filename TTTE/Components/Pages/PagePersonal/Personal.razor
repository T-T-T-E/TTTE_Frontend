@page "/personales"
@using TTTE.DTOs
@using TTTE.Services
@inject PersonalService PersonalService
@inject AutheService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Gestión de Personal</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Gestión de Personal</h1>
                <button class="btn btn-success" @onclick="AbrirModalCrear">
                    <i class="bi bi-plus-circle"></i> Nuevo Personal
                </button>
            </div>

            @if (!string.IsNullOrEmpty(mensajeNotificacion))
            {
                <div class="alert @claseNotificacion alert-dismissible fade show" role="alert">
                    @mensajeNotificacion
                    <button type="button" class="btn-close" @onclick="() => mensajeNotificacion = null" aria-label="Close"></button>
                </div>
            }


            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Lista de Personal</h5>
                </div>
                <div class="card-body">
                    @if (personals == null)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando usuarios...</span>
                            </div>
                        </div>
                    }
                    else if (!personals.Any())
                    {
                        <div class="text-center text-muted">
                            <p>No hay personal registrado.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>id</th>
                                        <th>Nombre</th>
                                        <th>Email</th>
                                        <th>Teléfono</th>
                                        <th>Rol</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var personal in GetPagedPersonal())
                                    {
                                        <tr>
                                            <td>@personal.Id</td>
                                            <td>@personal.nombreCompleto</td>
                                            <td>@personal.email</td>
                                            <td>@personal.telefono</td>
                                            <td>
                                                @if (personal.rol == 3)
                                                {
                                                    <span>Administrador</span>
                                                }
                                                else if (personal.rol == 1)
                                                {
                                                    <span>Cliente</span>
                                                }
                                                else
                                                {
                                                    <span>Barbero</span>
                                                }
                                            </td>

                                            <td>
                                                <button class="btn btn-warning btn-sm me-1" @onclick="() => EditarPersonal(personal)">
                                                    <i class="bi bi-pencil"></i> Editar
                                                </button>
                                                <button class="btn btn-danger btn-sm" @onclick="() => MostrarModalEliminar(personal)">
                                                    <i class="bi bi-trash"></i> Eliminar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            @* Agregar controles de paginación *@
                            @if ((personals?.Count ?? 0) > 0)
                            {
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div>
                                        Mostrando @(((currentPage - 1) * pageSize) + 1) a @(Math.Min(currentPage * pageSize, personals?.Count ?? 0)) de @(personals?.Count ?? 0) registros
                                    </div>
                                    <nav>
                                        <ul class="pagination">
                                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                                <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" disabled="@(currentPage == 1)">
                                                    Anterior
                                                </button>
                                            </li>

                                            @for (int i = 1; i <= totalPages; i++)
                                            {
                                                <li class="page-item @(i == currentPage ? "active" : "")">
                                                    <button class="page-link" @onclick="() => ChangePage(i)">
                                                        @i
                                                    </button>
                                                </li>
                                            }

                                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                                <button class="page-link" @onclick="() => ChangePage(currentPage + 1)" disabled="@(currentPage == totalPages)">
                                                    Siguiente
                                                </button>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>




@if (mostrarModal)
{
    <div class="modal" tabindex="-1" style="display:block">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modoEdicion ? "Editar Personal" : "Nuevo Personal")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    @if (!modoEdicion)
                    {
                        <EditForm Model="@personalFormulario" OnValidSubmit="GuardarPersonal">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label for="nombreCompleto" class="form-label">Nombre Completo</label>
                                <InputText id="nombreCompleto" class="form-control" @bind-Value="personalFormulario.nombreCompleto" />
                            </div>
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <InputText id="email" class="form-control" @bind-Value="personalFormulario.email" />
                            </div>
                            <div class="mb-3">
                                <label for="telefono" class="form-label">Teléfono</label>
                                <InputText id="telefono" class="form-control" @bind-Value="personalFormulario.telefono" />
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">Contraseña</label>
                                <InputText type="password" id="password" class="form-control" @bind-Value="personalFormulario.password" />
                            </div>
                            <div class="mb-3">
                                <label for="rol" class="form-label">Rol</label>
                                <select id="rol" class="form-select" @bind="personalFormulario.rol">
                                    <option value="">Selecione uno</option>
                                    <option value="admin">Administrador</option>
                                    <option value="barbero">Barbero</option>
                                </select>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                                <button type="submit" class="btn btn-success">Guardar</button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <EditForm Model="@personalFormularioEditar" OnValidSubmit="GuardarPersonalEditar">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label for="nombreCompletoEditar" class="form-label">Nombre Completo</label>
                                <InputText id="nombreCompletoEditar" class="form-control" @bind-Value="personalFormularioEditar.nombreCompleto" />
                            </div>
                            <div class="mb-3">
                                <label for="emailEditar" class="form-label">Email</label>
                                <InputText id="emailEditar" class="form-control" @bind-Value="personalFormularioEditar.email" />
                            </div>
                            <div class="mb-3">
                                <label for="telefonoEditar" class="form-label">Teléfono</label>
                                <InputText id="telefonoEditar" class="form-control" @bind-Value="personalFormularioEditar.telefono" />
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">Contraseña</label>
                                <InputText type="password" id="password" class="form-control" @bind-Value="personalFormularioEditar.password" />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                                <button type="submit" class="btn btn-primary">Guardar</button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@* Modal de confirmación de eliminación *@
@if (mostrarModalConfirmacion)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalConfirmacion"></button>
                </div>
                <div class="modal-body">
                    ¿Está seguro de que desea eliminar al usuario <strong>@Eliminarpersonal?.nombreCompleto</strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalConfirmacion">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="EliminarPersonal">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DatosPersonal>? personals;
    private DatosPersonal? Eliminarpersonal;
    // Para crear
    private CrearPersonal personalFormulario = new();
    // Para editar
    private DatosPersonal personalFormularioEditar = new();
    private bool mostrarModal;
    private bool modoEdicion;

    // Variables para el mensaje de notificación
    private string mensajeNotificacion;
    private string claseNotificacion;
    private bool mostrarMensaje = false;

    private int? idPersonalEditando;

    // Para eliminar
    private bool mostrarModalConfirmacion = false;

    // Variables para paginación
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => personals is { Count: > 0 }
    ? (int)Math.Ceiling(personals.Count / (double)pageSize)
    : 1;

    protected override async Task OnInitializedAsync()
    {
        await VerificarAutenticacion();
        await CargarPersonal();
    }

    private async Task VerificarAutenticacion()
    {
        var token = await AuthService.GetToken();
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task CargarPersonal()
    {
        try
        {
            var listaOriginal = await PersonalService.ObtenerPersonalAsync();
            currentPage = 1; // Resetear a la primera página cuando se cargan nuevos datos
            personals = listaOriginal
                .OrderByDescending(p => p.Id)
                .ToList();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al cargar el personal: {ex.Message}", false);
        }
    }

    private void AbrirModalCrear()
    {
        personalFormulario = new CrearPersonal();
        modoEdicion = false;
        mostrarModal = true;
    }

    private void EditarPersonal(DatosPersonal personal)
    {
        personalFormularioEditar = new DatosPersonal
        {
            Id = personal.Id,
            nombreCompleto = personal.nombreCompleto,
            email = personal.email,
            telefono = personal.telefono,
            password = ""
        };
        idPersonalEditando = personal.Id;
        modoEdicion = true;
        mostrarModal = true;
    }

    // Llama este método desde el botón de la tabla
    private void MostrarModalEliminar(DatosPersonal personal)
    {
        Eliminarpersonal = personal;
        mostrarModalConfirmacion = true;
    }

    private void CerrarModalConfirmacion()
    {
        Eliminarpersonal = null;
        mostrarModalConfirmacion = false;
    }

    private async Task EliminarPersonal()
    {
        if (Eliminarpersonal is null)
            return;

        var resultado = await PersonalService.EliminarPersonalAsync(Eliminarpersonal.Id);
        mostrarModalConfirmacion = false;

        if (resultado)
        {
            await CargarPersonal();
            MostrarMensaje("Personal eliminado correctamente", true); // ✅ Muestra mensaje de éxito
        }
        else
        {
            MostrarMensaje("No se pudo eliminar el personal.", false); // ❌ Muestra mensaje de error
        }
    }

    private async Task GuardarPersonal()
    {
        try
        {
            var resultado = await PersonalService.CrearPersonalAsync(personalFormulario);
            if (resultado)
            {
                await CargarPersonal();
                CerrarModal();
                MostrarMensaje("Personal creado correctamente", true); // ✅ Muestra mensaje de éxito
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al guardar el personal: {ex.Message}", false); // ❌ Muestra mensaje de error
        }
    }

    private async Task GuardarPersonalEditar()
    {
        try
        {
            var personalActualizar = new ActualizarPersonal
            {
                nombreCompleto = personalFormularioEditar.nombreCompleto,
                email = personalFormularioEditar.email,
                telefono = personalFormularioEditar.telefono,
                password = string.IsNullOrWhiteSpace(personalFormularioEditar.password) ? "" : personalFormularioEditar.password
            };
            var resultado = await PersonalService.ActualizarPersonalAsync(idPersonalEditando ?? 0, personalActualizar);
            if (resultado)
            {
                await CargarPersonal();
                CerrarModal();
                MostrarMensaje("Personal actualizado correctamente", true); // ✅ Muestra mensaje de éxito
            }
            else
            {
                MostrarMensaje("Error al actualizar el personal.", false); // ❌ Muestra mensaje de error
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al actualizar el personal: {ex.Message}", false); // ❌ Muestra mensaje de error
        }
    }
    private void CerrarModal()
    {
        mostrarModal = false;
        personalFormulario = new CrearPersonal();
        personalFormularioEditar = new DatosPersonal();
        modoEdicion = false;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private IEnumerable<DatosPersonal> GetPagedPersonal()
    {
        return personals?
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            ?? Enumerable.Empty<DatosPersonal>();
    }

    // Función auxiliar para mostrar el mensaje
    private async void MostrarMensaje(string mensaje, bool esExito)
    {

        mensajeNotificacion = mensaje;
        claseNotificacion = esExito ? "alert-success" : "alert-danger";
        mostrarMensaje = true;
        OcultarMensajeAutomatico();

    }

    private async Task OcultarMensajeAutomatico()
    {
        await Task.Delay(5000);
        mostrarMensaje = false;
        StateHasChanged();
    }


}


