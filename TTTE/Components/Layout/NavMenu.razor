@using TTTE.DTOs
@using TTTE.Services
@using System.IdentityModel.Tokens.Jwt;

<style>
    .navbar-toggler {
        appearance: none;
        cursor: pointer;
        width: 3.5rem;
        height: 2.5rem;
        color: black;
        position: absolute;
        top: 0.5rem;
        right: 1rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 0.55%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") no-repeat center/1.75rem rgba(255, 255, 255, 0.1);
    }

        .navbar-toggler:checked {
            background-color: #c5ab7a;
        }

    .top-row {
        height: 3.5rem;
        background-color: #c5ab7a;
    }

    .navbar-brand {
        font-size: 1.1rem;
        color: white !important;
    }

    .nav-item {
        font-size: 0.9rem;
        padding-bottom: 0.5rem;
    }

        .nav-item:first-of-type {
            padding-top: 1rem;
        }

        .nav-item:last-of-type {
            padding-bottom: 1rem;
        }

        /* Modifica el estilo del nav-link para mejorar el alineamiento */
        .nav-item ::deep .nav-link {
            color: black;
            background: none;
            border: none;
            border-radius: 4px;
            height: 3rem;
            display: flex;          /* Asegura que sea flex */
            align-items: center;    /* Centra verticalmente */
            padding: 0.5rem 1rem;   /* Ajusta el padding */
            width: 100%;
            transition: all 0.3s ease;
            gap: 0.5rem;           /* Espacio entre icono y texto */
        }

        .nav-item ::deep a.active {
            background-color: #c5ab7a;
            color: black;
        }

        .nav-item ::deep .nav-link:hover {
            background-color: #c5ab7a;
            color: black;
            transform: translateX(5px);
        }

    .nav-scrollable {
        background-color: #c5ab7a;
        display: none;
    }

    /* Estilos para los íconos */
    .nav-item ::deep .bi {
        margin-right: 0.75rem;
        font-size: 1.2rem;
        vertical-align: middle;
    }

    .navbar-toggler:checked ~ .nav-scrollable {
        display: block;
    }

    @@media (min-width: 641px) {
        .navbar-toggler {
            display: none;
        }

        .nav-scrollable {
            display: block;
            height: calc(100vh - 3.5rem);
            overflow-y: auto;
        }
    }

    /* Estilo para la barra de desplazamiento */
    .nav-scrollable::-webkit-scrollbar {
        width: 5px;
    }

    .nav-scrollable::-webkit-scrollbar-track {
        background: white;
    }

    .nav-scrollable::-webkit-scrollbar-thumb {
        background: #3498db;
        border-radius: 5px;
    }

        .nav-scrollable::-webkit-scrollbar-thumb:hover {
            background: white;
        }

    navbar{
        background: white;
    }

</style>

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-scissors" viewBox="0 0 16 16">
                <path d="M3.5 3.5c-.614-.884-.074-1.962.858-2.5L8 7.226 11.642 1c.932.538 1.472 1.616.858 2.5L8.81 8.61l1.556 2.661a2.5 2.5 0 1 1-.794.637L8 9.73l-1.572 2.177a2.5 2.5 0 1 1-.794-.637L7.19 8.61zm2.5 10a1.5 1.5 0 1 0-3 0 1.5 1.5 0 0 0 3 0m7 0a1.5 1.5 0 1 0-3 0 1.5 1.5 0 0 0 3 0" />
            </svg> TTTE BARBERSHOP
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

